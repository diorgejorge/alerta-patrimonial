{
  "ci": {
    "collect": {
      "staticDistDir": "./_demo/docs",
      "url": ["http://localhost/index.html", "http://localhost/pessoa/p0001.html"],
      "numberOfRuns": 1,
      "settings": { "formFactor": "mobile", "screenEmulation": { "mobile": true, "width": 360, "height": 740, "deviceScaleFactor": 2 } }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.9 }]
      }
    }
  }
}
